# ==========================================
# Global configs
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================

BACKEND=rdagent.oai.backend.LiteLLMAPIBackend

# DashScope（阿里云）OpenAI兼容端点
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-aca2359331ba4d0895cf5e7966a31e57

# 告诉 litellm 默认 provider 是 dashscope
LITELLM_DEFAULT_PROVIDER=dashscope

# 模型名写成 dashscope/…
CHAT_MODEL=dashscope/qwen-plus
EMBEDDING_MODEL=dashscope/text-embedding-v4
# ==========================================

# ==========================================

# ==========================================
# 其他可选项
# 当使用带 <think> 的推理模型时，去除思维过程
# REASONING_THINK_RM=True

# Cache（可选）
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# ==========================================