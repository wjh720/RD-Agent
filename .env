# ==========================================
# Global configs
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================

# ==========================================
# Backend Configuration
# 使用 LiteLLM 作为统一接入层
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
# ==========================================

# ==========================================
# DashScope（Qwen）配置 —— 统一用 dashscope 提供商
# 文档: https://docs.litellm.ai/docs/providers/dashscope
# 说明：使用 dashscope/* 前缀；Key 用 DASHSCOPE_API_KEY
# ==========================================
# 填入你的 DashScope API Key
DASHSCOPE_API_KEY=sk-aca2359331ba4d0895cf5e7966a31e57

# Chat 模型（Qwen）
CHAT_MODEL=dashscope/qwen-plus

# Embedding 模型（Qwen）
EMBEDDING_MODEL=dashscope/text-embedding-v4
# ==========================================

# ==========================================
# （可选）运行期 HTTP 代理（与 Docker 构建期无关）
# 若本机有代理可按需开启
http_proxy=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
# ==========================================

# ==========================================
# 其他可选项
# 当使用带 <think> 的推理模型时，去除思维过程
# REASONING_THINK_RM=True

# Cache（可选）
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# ==========================================