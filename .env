# ============================================
# RD-Agent 环境变量配置文件（Qwen / DashScope 兼容版）
# 聊天 + 向量 都使用阿里云 DashScope 的 OpenAI 兼容接口
# ============================================

# ---- 基础与重试策略 ----
BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
MAX_RETRY=10
RETRY_WAIT_SECONDS=20

# ---- DashScope（OpenAI 兼容）端点与密钥 ----
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=sk-aca2359331ba4d0895cf5e7966a31e57

# ---- 模型（带 provider 前缀 openai/）----
# Chat 模型（Qwen）
CHAT_MODEL=openai/qwen-plus
# Embedding 模型（Qwen）
EMBEDDING_MODEL=openai/text-embedding-v4

# ---- 可选：带 <think> 的推理模型时，去除思维过程 ----
# REASONING_THINK_RM=True

# ---- （可选）宿主机代理；仅影响 RD-Agent 运行期的网络，不影响 Docker 构建期 ----
# 若本机代理监听在 127.0.0.1:7890，可启用以下两行
http_proxy=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890