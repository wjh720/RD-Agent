# ==========================================
# Global configs
MAX_RETRY=10
RETRY_WAIT_SECONDS=20
# ==========================================

BACKEND=rdagent.oai.backend.LiteLLMAPIBackend
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=你的DashScopeKey

CHAT_MODEL=openai/qwen-plus
EMBEDDING_MODEL=openai/text-embedding-v4

# 关键：模型别名映射到 dashscope
LITELLM_MODEL_ALIAS_MAP={"openai/qwen-plus":"dashscope/qwen-plus","openai/text-embedding-v4":"dashscope/text-embedding-v4"}
LITELLM_DEFAULT_PROVIDER=dashscope
# ==========================================

# ==========================================

# ==========================================
# 其他可选项
# 当使用带 <think> 的推理模型时，去除思维过程
# REASONING_THINK_RM=True

# Cache（可选）
# USE_CHAT_CACHE=True
# USE_EMBEDDING_CACHE=True
# ==========================================